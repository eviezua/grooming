<div class="section-title m-auto container-wide">
    <h1 class="mb-4 text-center mt-5 ">
        <span>{{ 'Choose'|trans }}</span> {{ 'your groomer'|trans }}
    </h1>
</div>
<div id="filters" class="container-wide">
    <filter-panel></filter-panel>
</div>
<div class="hero-masters-wrapper container-wide">
    {% set groomers = [
        {name: 'Ольга Єрмоленко', address: 'м. Запоріжжя, Шевченківський р-н, вулиця Лапок 33, салон «PawStyle»', price: 700, photo: '1.png', rating: 5},
        {name: 'Ірина Петренко', address: 'м. Запоріжжя, Шевченківський р-н, вулиця Лапок 33, салон «PawStyle»', price: 800, photo: '2.png', rating: 4},
        {name: 'Інна Шевченко', address: 'м. Запоріжжя, Шевченківський р-н, вулиця Весняна 12, салон «4Paws» ', price: 650, photo: '3.png', rating: 4},
        {name: 'Ян Бондаренко', address: 'м. Запоріжжя, Шевченківський р-н, вулиця Івана Підкови 19', price: 720, photo: '4.png', rating: 3},
        {name: 'Тетяна Мельник', address: 'м. Запоріжжя, Шевченківський р-н, вулиця Весняна 12, салон «4Paws»', price: 680, photo: '5.png', rating: 5},
        {name: 'Олексій Коваль ', address: 'м. Запоріжжя, Шевченківський р-н, вулиця Почаївська 7', price: 710, photo: '6.png', rating: 4}
    ] %}
    {% for groomer in groomers %}
        <div class="hero-master bg-white position-relative p-5 my-5">
            <div class="d-flex align-items-center mt-3 gap-2">
                <h3 class="mb-0">{{ 'Rating:'|trans }}</h3>
                <star-rating :model-value="{{ groomer.rating }}" :readonly="true"></star-rating>
                <div class="circle-block d-flex position-absolute">
                    <img src="/uploads/photos/{{ groomer.photo }}" alt="{{ groomer.name }}">
                </div>
            </div>
            <h2 class="mb-2 mt-4">{{ groomer.name }}</h2>
            <h3 class="gray-text">{{ groomer.address }}</h3>
            <h3 class="my-4">Стрижка собаки до 5кг — {{ groomer.price }} грн</h3>
            <a class="mb-3">Обрати час <img src="/uploads/icons/arrow_black.png"></a>
        </div>
    {% endfor %}
</div>