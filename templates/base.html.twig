<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Homepage{% endblock %}</title>
    {{ encore_entry_link_tags('app') }}
</head>
<body>
<header class="groomify-header position-relative overflow-visible animated-bg">
    <div class="paw-bg"></div>
    {% include 'partials/_navigation.html.twig' with { location: 'header' } %}
    {% block header_extra %}{% endblock %}
</header>
<main id="app-vue" class="{{app.request.attributes.get('_route') != 'app_homepage' ? '' }}">
    {% block body %}
    {% endblock %}
</main>
<footer class="groomify-footer gap-4 p-4 bg-orange">
    {% include 'partials/_navigation.html.twig' with { location: 'footer' }%}
</footer>
{{ encore_entry_script_tags('app') }}
</body>
</html>
