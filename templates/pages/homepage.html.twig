{% extends 'base.html.twig' %}

{% block header_extra %}
    {% include 'partials/_hero.html.twig' %}
{% endblock %}

{% block body %}
    <div class="bg-white py-5">
        {% include 'partials/_info.html.twig' %}
    </div>
    <div class="bg-gray py-5">
        {% include 'partials/_masters.html.twig' with { preview: true } %}
        <a href="{{ path('app_groomers', {'_locale': app.request.locale}) }}" class="orange-but d-flex justify-content-center align-items-center text-white text-decoration-none inter-18 mx-auto" style="width: 182px; height: 73px;">
            {{ 'More'|trans }}
        </a>
    </div>
<div class="bg-gray py-5">
    <div class="section-title m-auto container-wide">
        <h1 class="mb-4 text-center">
            <span>{{ 'Questions'|trans }}</span> {{ '& answers'|trans }}
        </h1>
    </div>
    <faq-list :limit="6"></faq-list>
    <a href="{{ path('app_faq', {'_locale': app.request.locale}) }}" class="orange-but d-flex justify-content-center align-items-center text-white text-decoration-none inter-18 mx-auto" style="width: 182px; height: 73px;">
        {{ 'More'|trans }}
    </a>
</div>
<div class="animated-bg position-relative justify-content-center z-2">
    {% include 'partials/_join-form.html.twig' %}
</div>
{% endblock %}
